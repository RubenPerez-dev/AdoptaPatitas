# Copia este archivo como .env y rellena los valores reales.
# .env NUNCA debe subirse al repositorio (ya está en .gitignore).

# Clave secreta de Django. Genera una propia para cada entorno, por ejemplo con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme

# True solo en desarrollo local. En producción debe ser False.
DEBUG=True

# Hosts permitidos, separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Configuración de la base de datos PostgreSQL.
DB_NAME=adoptapatitas_dev
DB_USER=adoptapatitas_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
